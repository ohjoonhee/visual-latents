# Copy to .env (gitignored). Per-machine overrides.

# REQUIRED: which machine paths.py resolves to.
MACHINE=local                   # local | bioai

# REQUIRED on cluster — points HF cache to /data/joonhee/.cache/huggingface
# (already set in ~/.bashrc on bioai; export here only if not loaded by shell rc)
# HF_HOME=/data/joonhee/.cache/huggingface

# W&B
WANDB_PROJECT=visual-latents
WANDB_API_KEY=                  # personal key
# WANDB_ENTITY=ohjoonhee

# Cluster-only: Slack notify webhook for sbatch jobs
# SLACK_WEBHOOK_URL=

# Optional overrides
# TOKENIZERS_PARALLELISM=false
